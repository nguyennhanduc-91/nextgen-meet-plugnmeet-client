{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgen-meet-plugnmeet-client",
  "main": "./worker.js",
  "compatibility_date": "2025-03-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
